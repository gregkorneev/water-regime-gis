{
  "project": {
    "name": "water-regime-gis",
    "stage": "stage-1",
    "description": "Базовый контур проекта без реальных геоданных и сложной обработки."
  },
  "qgis": {
    "target_crs": "EPSG:32637",
    "project_file": "outputs/maps/water_regime_gis.qgs",
    "python_executable": "",
    "script_runner": "scripts/qgis/check_qgis_context.py",
    "nspd_plugin_check_script": "scripts/qgis/check_nspd_plugin.py",
    "demo_project_script": "scripts/qgis/create_demo_project.py",
    "satellite_indices_script": "scripts/qgis/process_satellite_indices.py",
    "select_field_script": "scripts/qgis/select_field_point.py",
    "resolve_boundary_script": "scripts/qgis/resolve_field_boundary.py",
    "field_buffer_meters": 500
  },
  "nspd": {
    "plugin_id": "rosreestr-search-qgis-plugin-master",
    "plugin_name": "rosreestr-search-qgis-plugin",
    "plugin_url": "https://plugins.qgis.org/plugins/rosreestr-search-qgis-plugin-master/",
    "plugin_download_url": "https://plugins.qgis.org/plugins/rosreestr-search-qgis-plugin-master/version/2.5/download/",
    "parcels_wms_layer_id": 36048,
    "parcels_wms_name": "Земельные участки из ЕГРН",
    "local_wms_proxy_url": "http://127.0.0.1:8765/nspd/wms",
    "feature_info_span_meters": 500,
    "max_selected_parcel_area_ha": 2000
  },
  "paths": {
    "test_aoi": "data/aoi/tula_test_field.geojson",
    "selected_field_point": "data/aoi/selected_field_point.geojson",
    "selected_field_area": "data/aoi/selected_field_area.geojson",
    "aoi": "data/aoi",
    "raw": "data/raw",
    "interim": "data/interim",
    "processed": "data/processed",
    "maps": "outputs/maps",
    "latest_report": "outputs/reports/latest_result.json",
    "reports": "outputs/reports",
    "rasters": "outputs/rasters"
  },
  "satellite": {
    "provider": "planetary-computer-stac",
    "collection": "sentinel-2-l2a",
    "date_range_days": 60,
    "max_cloud_cover": 30,
    "preferred_scene": "least_cloudy",
    "preview_index": "NDMI",
    "sources": ["sentinel-2", "landsat"],
    "indices": ["NDVI", "NDMI", "NDWI", "MNDWI", "SAVI", "NDRE"]
  },
  "dem": {
    "products": ["slope", "aspect", "flow_accumulation", "watersheds"]
  }
}
