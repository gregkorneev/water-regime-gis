# Geo data: keep directories, avoid committing heavy data by default
data/raw/**
data/interim/**
data/processed/**
outputs/rasters/**
outputs/maps/**
outputs/reports/**

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!outputs/rasters/.gitkeep
!outputs/maps/.gitkeep
!outputs/reports/.gitkeep

# Common heavy raster / remote-sensing formats
*.tif
*.tiff
*.vrt
*.img
*.jp2
*.hdf
*.nc
*.grib
*.grb
*.las
*.laz
*.mbtiles

# Small AOI/config examples may be committed intentionally.
!docs/**
!configs/**

# Local user selections from the app.
data/aoi/selected_field_*.geojson
